# Backend
PORT=3000

# Comma separated list of allowed frontend origins (CORS).
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGO_URI=

# Secret used to sign the auth cookie
JWT_SECRET=

# Cloud AI provider (SenseNova, OpenAI compatible).
# When SENSENOVA_API_KEY is set it is used for both AI passes.
SENSENOVA_BASE_URL=https://token.sensenova.ai/v1
SENSENOVA_API_KEY=
SENSENOVA_MODEL=sensenova-6.8-flash-lite

# Local AI provider (used when no cloud key is configured).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Context window and answer length for the local model.
# The prompt (resume + job description) plus the answer have to fit in the
# context window, otherwise the answer is cut off and the JSON is invalid.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
